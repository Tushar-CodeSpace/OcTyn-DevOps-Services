# ============================================================
# OcTyn DevOps Services Agent Environment Configuration
#
# Provide only SERVER_ID, API_URL, and API_KEY in this file.
# All other monitoring configurations (intervals, monitored services,
# connectivity ping targets, mongo config backup) are pulled
# dynamically from the central server on boot.
# ============================================================

# --- Server Identity (UUID from dashboard) ---
SERVER_ID=

# --- Central API Endpoint ---
API_URL=http://127.0.0.1:8000/api/v1

# --- Agent API Key ---
API_KEY=
