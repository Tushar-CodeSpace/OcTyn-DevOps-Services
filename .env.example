# ============================================================
# OcTyn DevOps Services - root environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- MongoDB ---
# Root admin (created on first boot by the mongo image; keep safe)
MONGO_INITDB_ROOT_USERNAME=monitoring_root
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password
# Application user for the backend (least privilege, db-scoped)
MONGO_APP_USER=monitoring_app
MONGO_APP_PASSWORD=change-me-app-password
# Application database
MONGO_INITDB_DATABASE=central_monitoring

# --- Public domain (used by nginx / backend CORS) ---
DOMAIN=monitoring.example.com

# --- Backend ---
BACKEND_PORT=8000
# JWT signing secret (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-jwt-secret
# CORS origins (comma-separated; * for local dev only)
CORS_ORIGINS=*
# Backend log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# --- Frontend ---
# Host port for the frontend (80 on the VPS, 8080 locally)
FRONTEND_PORT=80